# Learnify configuration. Copy to .env for local development; in production use your host's
# secret manager. Everything is validated at startup (server/config/env.ts) — the server
# refuses to start with a clear message if something required is missing.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Any PostgreSQL 14+ database. Add ?sslmode=require for hosted providers (Neon, RDS, …).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learnify
# DATABASE_POOL_MAX=10

# Public origin of the app. REQUIRED in production (used for CSRF/CORS decisions).
# APP_URL=https://learnify.example.com
# Extra origins allowed to call the API with cookies (comma-separated). Usually empty.
CORS_ORIGINS=
# Number of reverse proxies in front of the app (load balancer = 1). Used for client IPs.
TRUST_PROXY=1
# LOG_LEVEL=info

# --- Sessions ---------------------------------------------------------------
# Secure cookies default to on in production. Only override for local HTTPS testing.
# COOKIE_SECURE=true
SESSION_TTL_DAYS=7
# 32+ random characters. Required only when Google sign-in is enabled.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# SESSION_SECRET=

# --- AI tutor ---------------------------------------------------------------
# "openai" (default) or "mock" (offline, deterministic; not allowed in production).
AI_PROVIDER=mock
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # OpenAI-compatible gateway (optional)
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_MODERATION=true
# Cost & safety limits
AI_TIMEOUT_MS=25000
AI_MAX_OUTPUT_TOKENS=450
AI_CONTEXT_MESSAGES=12
AI_MAX_TURNS_PER_ASSIGNMENT=40
AI_DAILY_TURNS_PER_USER=150
AI_DAILY_AUDIO_SECONDS_PER_USER=1800
TRANSCRIPTION_ENABLED=true
MAX_AUDIO_SECONDS=60
MAX_AUDIO_BYTES=3145728

# --- Web push (optional) ----------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# --- Email (optional) -------------------------------------------------------
# Enables "Forgot password?" emails via Resend (https://resend.com). Without it, teachers can
# still create one-time reset links for students in their classes.
RESEND_API_KEY=
# EMAIL_FROM="Learnify <no-reply@your-domain.com>"

# --- Google sign-in (optional) ----------------------------------------------
# Authorised redirect URI in Google Cloud Console must equal GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://learnify.example.com/api/auth/google/callback
