# Copy to .env (or set in your host's secret manager). Never commit real values.

# --- Required ---
# Any PostgreSQL database (Neon, RDS, Supabase, self-hosted). Add ?sslmode=require for hosted DBs.
DATABASE_URL=postgresql://user:password@localhost:5432/learnify

# OpenAI API key for the AI tutor.
OPENAI_API_KEY=
# Optional: OpenAI-compatible gateway and model override.
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
# (On Replit, AI_INTEGRATIONS_OPENAI_API_KEY / AI_INTEGRATIONS_OPENAI_BASE_URL are also accepted.)

# --- Server ---
PORT=5000
# Number of reverse proxies in front of the app (load balancer, Cloudflare...). Used for rate-limit IPs.
TRUST_PROXY=1
# Comma-separated origins allowed to call the API cross-origin. Leave empty for same-origin only.
CORS_ORIGINS=

# --- Optional: Web push notifications ---
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# --- Optional: Google sign-in (server routes only; no UI yet) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
