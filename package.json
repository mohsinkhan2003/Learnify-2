{
  "name": "learnify",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts server/db/migrate-cli.ts --platform=node --packages=external --bundle --format=esm --outdir=dist --entry-names=[name] && mv dist/migrate-cli.js dist/migrate.js",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "db:migrate:prod": "node dist/migrate.js"
  },
  "dependencies": {
